# One HTTP/WebSocket port for API, game client, and realtime transport.
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Local vertical-slice persistence. Keep this file outside the client bundle.
DATABASE_PATH=./data/taxi-lib.sqlite
SESSION_TTL_DAYS=7

# Set to an explicit public origin in production; same-origin is used locally.
# PUBLIC_ORIGIN=https://taxi-lib.example.com
